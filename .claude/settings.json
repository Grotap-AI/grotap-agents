{
  "_warning": "GENERATED - do not edit this file directly in grotap-agents. Update scripts/claudecode/agents-tree/.claude/settings.json in grotap-platform and hand-copy.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/claudecode/session-start-hook.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash|write",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/claudecode/run-python-hook.sh competitor-name-guard.py",
            "timeout": 15,
            "statusMessage": "competitor-name guard"
          }
        ]
      },
      {
        "matcher": "Bash|Grep|Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/claudecode/run-python-hook.sh stale-evidence-guard.py",
            "timeout": 10,
            "statusMessage": "stale-evidence guard"
          }
        ]
      }
    ]
  },
  "enableAllProjectMcpServers": true,
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "ui-ux-pro-max-skill": {
      "source": {
        "source": "github",
        "repo": "nextlevelbuilder/ui-ux-pro-max-skill"
      }
    }
  },
  "enabledPlugins": {
    "codex@openai-codex": true,
    "code-simplifier@claude-plugins-official": true
  }
}
